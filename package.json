{
  "name": "nabd-ai",
  "version": "1.0.0",
  "description": "NABD AI - Telegram monitoring, AI analysis and automation platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "setup": "bash scripts/termux-setup.sh",
    "up": "bash scripts/start.sh",
    "down": "bash scripts/stop.sh",
    "status": "bash scripts/status.sh"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "express": "^4.21.0",
    "fflate": "^0.8.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "telegram": "^2.26.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
}
