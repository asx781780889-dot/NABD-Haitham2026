# NABD AI configuration. Copy to .env (scripts/termux-setup.sh does this for you with fresh random secrets).
# NEVER commit the real .env. Back up MASTER_KEY: encrypted sessions / API keys / backups cannot be recovered without it.

NODE_ENV=production
HOST=127.0.0.1               # 0.0.0.0 to reach the dashboard from other devices (put HTTPS in front of it!)
PORT=8080

# PostgreSQL (primary database) and Redis (queue, cache, locks, rate limiting)
DATABASE_URL=postgres://nabd:CHANGE_ME@127.0.0.1:5432/nabd
# auto enables TLS for Railway hosts; use true when the provider requires TLS
DATABASE_SSL=auto
PG_CONNECTION_TIMEOUT_MS=10000
# API and worker pools share the Railway database quota; keep this modest.
PG_POOL_MAX=5
PG_MAX_LIFETIME_S=300
REDIS_URL=redis://127.0.0.1:6379

# 32 random bytes, base64 or hex:   openssl rand -base64 32      (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MASTER_KEY=
# During key rotation only (see docs/SECURITY.md): the previous key
# MASTER_KEY_OLD=

DATA_DIR=./data              # backups, exports, logs
COOKIE_SECURE=auto           # auto | true | false  (auto = Secure cookie when the request is HTTPS)
TRUST_PROXY=false            # true when running behind nginx / Railway / Render (needed for correct client IPs + HTTPS detection)
ALLOWED_ORIGINS=             # extra browser origins allowed for state-changing requests, comma separated
LOG_LEVEL=info               # debug | info | warning | error | critical
AUTO_MIGRATE=true            # apply database migrations on start (safe: advisory-locked)
SERVE_STATIC=true            # API serves the web UI (disable when nginx serves ./public)
EMBED_WORKER=false           # true = run workers inside the API process (single-process mode for very small devices)
WORKER_ONLY=                 # worker service: comma list of modules to run (telegram,processor,keyword,ai,notification,analytics,cleanup,scheduler)
PG_DUMP_PATH=pg_dump         # needed for database backups
# METRICS_TOKEN=             # when set, /metrics requires "Authorization: Bearer <token>" (otherwise: loopback or a signed-in user)
